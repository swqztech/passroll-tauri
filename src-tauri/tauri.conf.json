{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "随密",
  "version": "1.0.0",
  "identifier": "com.codes.passroll.tauri",
  "build": {
    "beforeDevCommand": "npm run dev:serve",
    "devUrl": "http://localhost:5182",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "随密",
        "width": 720,
        "height": 780,
        "minWidth": 560,
        "minHeight": 640,
        "backgroundColor": "#12101a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
